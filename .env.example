# Copy to .env for Docker Compose. Never commit real credentials.
POSTGRES_DB=synapse_keepr
POSTGRES_USER=synapse_keepr
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
